FROM ubuntu:24.04 AS base

LABEL maintainer="security@example.com"
LABEL description="Hardened Linux container with security best practices"
LABEL version="1.0"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Install security packages and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core security tools
    apparmor \
    apparmor-utils \
    auditd \
    audispd-plugins \
    aide \
    # Intrusion prevention
    fail2ban \
    # Automatic updates
    unattended-upgrades \
    apt-listchanges \
    needrestart \
    # Monitoring and utilities
    sysstat \
    htop \
    net-tools \
    iproute2 \
    procps \
    # Security scanning
    lynis \
    rkhunter \
    chkrootkit \
    # Essential tools
    curl \
    wget \
    gnupg \
    ca-certificates \
    openssl \
    sudo \
    vim \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy security configurations
COPY configs/sysctl.d/99-security.conf /etc/sysctl.d/99-security.conf
COPY configs/auditd/audit.rules /etc/audit/rules.d/audit.rules
COPY configs/aide/aide.conf /etc/aide/aide.conf
COPY configs/unattended-upgrades/50unattended-upgrades /etc/apt/apt.conf.d/50unattended-upgrades

# Copy security scripts
COPY scripts/ /opt/security/scripts/
RUN chmod +x /opt/security/scripts/*.sh

# Create non-root user for security
RUN useradd -m -s /bin/bash -G sudo secuser \
    && echo "secuser ALL=(ALL) NOPASSWD: /opt/security/scripts/*" >> /etc/sudoers.d/secuser

# Apply kernel hardening parameters (those applicable in container)
RUN sysctl -p /etc/sysctl.d/99-security.conf 2>/dev/null || true

# Initialize AIDE database
RUN aideinit 2>/dev/null || true

# Set secure permissions
RUN chmod 700 /root \
    && chmod 750 /home/secuser \
    && chmod 640 /etc/shadow \
    && chmod 644 /etc/passwd

# Remove unnecessary packages and clean up
RUN apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ps aux | grep -v grep | grep -q auditd || exit 1

# Default to non-root user
USER secuser
WORKDIR /home/secuser

CMD ["/bin/bash"]
