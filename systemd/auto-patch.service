[Unit]
Description=Automated Security Patching Service
Documentation=file:///opt/security/docs/patch-management.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/security/scripts/auto-patch.sh

[Service]
Type=oneshot
ExecStart=/opt/security/scripts/auto-patch.sh
ExecStartPost=/opt/security/scripts/compatibility-check.sh verify
StandardOutput=journal
StandardError=journal
SyslogIdentifier=auto-patch

# Security hardening
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
